# ============================================
# Habitus - Git Ignore Configuration
# ============================================
# This file ensures that build artifacts, local environments, IDE metadata,
# and temporary files are NOT committed to the repository.
#
# NOTE: If any of these files are already tracked by Git, you must manually
# remove them using: git rm --cached <file-or-directory>
# ============================================

# ============================================
# Operating System Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~

# ============================================
# General Temporary & Log Files
# ============================================
*.log
*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig

# ============================================
# Environment & Secrets
# ============================================
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials/

# ============================================
# IDE & Editor Files
# ============================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.metadata
.factorypath

# VS Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-v][a-z]
[._]sw[a-p]

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ============================================
# Java / Maven (backend-java/authservice)
# ============================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Compiled Java classes
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven specific
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

